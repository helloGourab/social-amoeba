generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id         String   @id @default(cuid())
  authorId   String   // Clerk User ID
  authorName String?  // Added this (Optional to handle existing records)
  content    String
  createdAt  DateTime @default(now())
}